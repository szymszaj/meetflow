generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum ExceptionType {
  BLOCKED
  CUSTOM_HOURS
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  RESCHEDULED
}

// ─── Auth.js (NextAuth) models ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core domain models ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Host public profile
  slug     String @unique // /[slug]/[eventTypeSlug]
  timezone String @default("Europe/Warsaw")

  // Booking behaviour
  bufferMinutes     Int @default(15)
  bookingWindowDays Int @default(30)

  // Auth.js
  accounts Account[]
  sessions Session[]

  // Host domain
  eventTypes             EventType[]
  availabilities         Availability[]
  availabilityExceptions AvailabilityException[]
  bookings               Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per event type the host offers (e.g. "Konsultacja 30 min")
model EventType {
  id              String  @id @default(cuid())
  hostId          String
  name            String
  slug            String // unique per host, used in URL
  description     String?
  durationMinutes Int
  isActive        Boolean @default(true)
  color           String  @default("#6366f1")

  host     User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hostId, slug])
}

// Weekly recurring availability window — hours stored as "HH:MM" in host's timezone
model Availability {
  id        String    @id @default(cuid())
  hostId    String
  dayOfWeek DayOfWeek
  startTime String // "09:00"
  endTime   String // "17:00"

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([hostId, dayOfWeek])
}

// Per-date override: either block the day entirely or replace hours with custom window
model AvailabilityException {
  id          String        @id @default(cuid())
  hostId      String
  date        DateTime      @db.Date // calendar date; compared against host's timezone
  type        ExceptionType
  customStart String? // "HH:MM", only for CUSTOM_HOURS
  customEnd   String? // "HH:MM", only for CUSTOM_HOURS

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([hostId, date])
}

model Booking {
  id          String @id @default(cuid())
  hostId      String
  eventTypeId String

  guestName     String
  guestEmail    String
  guestTimezone String
  notes         String?

  startTime DateTime // UTC
  endTime   DateTime // UTC

  status BookingStatus @default(CONFIRMED)
  // Unguessable token e-mailed to the guest — powers cancel/reschedule URLs
  token  String        @unique @default(cuid())

  cancelledAt DateTime?

  host      User      @relation(fields: [hostId], references: [id])
  eventType EventType @relation(fields: [eventTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // DB-level unique constraint = primary defence against concurrent double-bookings.
  // Application still validates overlaps, but this is the hard guarantee.
  @@unique([hostId, startTime])
}
